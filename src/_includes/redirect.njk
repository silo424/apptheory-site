<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Redirecting…</title>
  <link rel="canonical" href="{{ site.url }}{{ redirectTo }}">
  <meta http-equiv="refresh" content="0; url={{ redirectTo }}">
  <meta name="robots" content="noindex">
  <script>location.replace({{ redirectTo | dump | safe }} + location.hash);</script>
</head>
<body>
  <p>This page has moved to <a href="{{ redirectTo }}">{{ site.url }}{{ redirectTo }}</a>.</p>
</body>
</html>
